# Forex Bot Configuration
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# 🚀 LIVE TRADING SETTINGS
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TRADING_MODE=live  # Options: paper, live
RISK_PERCENTAGE=1.0
MAX_POSITIONS=3

# 🛡️ SAFETY SETTINGS
MAX_LOT_SIZE=0.5
MAX_TRADE_DURATION_MINUTES=30
MAX_SPREAD_PIPS=2.0
TRADING_HOURS_START=6
TRADING_HOURS_END=20

# 📊 TRADING PARAMETERS
SYMBOL=EURUSD
TIMEFRAME=M15
CYCLE_SECONDS=300
MIN_CONFIDENCE=45
